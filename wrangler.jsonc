{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "image-color-remover",
  "main": "./src/worker.js",
  "compatibility_date": "2026-10-05",
  "workers_dev": true,
  "preview_urls": true,
  "routes": [
    {
      "pattern": "imagecolorremover.com",
      "custom_domain": true
    },
    {
      "pattern": "www.imagecolorremover.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  }
}
